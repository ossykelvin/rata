# Template only. Copy to `.env.local` and fill in real values there.
# `.env.local` is git-ignored; this file is tracked, so it must never contain
# a real secret.
#
# Rules (AGENTS.md 12, 13 and docs/SECURITY.md):
# - Never hardcode a key in source. Read it from the environment.
# - Read secrets in the Electron main process only. Never expose one to the
#   renderer, and never bundle one into `dist/`.
# - Never log a key or place one in an audit event.
# - For production, move these to OS-backed secret storage. A plain file is a
#   development convenience, not a secret store.

# No live provider is required for the MVP.
RATA_AI_PROVIDER=mock

# Serper.dev web search API key.
# Consumed by the web search adapter (RATA-SKILL-008, docs/SKILLS-HANDOVER.md),
# which is not built yet. Must reach the network only through a registered
# tool that declares its risk and confirmation policy.
RATA_SERPER_API_KEY=
