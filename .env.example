# Template only. Copy to `.env.local` and fill in real values there.
# `.env.local` is git-ignored; this file is tracked, so it must never contain
# a real secret.
#
# Rules (AGENTS.md 12, 13 and docs/SECURITY.md):
# - Never hardcode a key in source. Read it from the environment.
# - Secrets are read in the Electron main process only (electron/config.cjs).
#   They are never sent over IPC, never written to the JSON store, and never
#   placed in an audit event. The renderer learns booleans, not values.
# - For production, move these to OS-backed secret storage. A plain file is a
#   development convenience, not a secret store.
#
# Real environment variables override these files, so CI or a shell export wins.

# Provider mode used when the stored setting has never been changed.
# One of: mock | gemini | openrouter | auto
# Ships as `mock` so a fresh install performs no network egress until you opt in.
RATA_AI_PROVIDER=mock

# --- Primary AI provider: Google Gemini --------------------------------
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.0-flash.
GEMINI_MODEL=

# --- Secondary AI provider: OpenRouter ---------------------------------
# Used when Gemini fails or times out, and tried first for complex requests.
OPENROUTER_API_KEY=
# Optional. Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
# Optional. Defaults to anthropic/claude-3.5-sonnet.
OPENROUTER_MODEL=

# --- Web search: Serper ------------------------------------------------
# Backs the `web.search` tool. The tool asks for approval by default because
# the query leaves your machine — see ADR-006.
RATA_SERPER_API_KEY=
